{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/dist", "!**/out", "!**/tsconfig.json", "!**/.svelte-kit"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on", "useSortedProperties": "on" } } },
  "linter": {
    "domains": {
      "project": "recommended",
      "svelte": "recommended",
      "types": "recommended"
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off"
      },
      "suspicious": {
        "noUnsafeDeclarationMerging": "off",
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "recommended": true,
        "noParameterAssign": "off"
      },
      "a11y": "off"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
